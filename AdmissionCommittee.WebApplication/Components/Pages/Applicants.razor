@page "/"
@using System.Globalization;
@inject IRepository<Applicant, int> applicantRepository;
@inject IRepository<AdmissionCommittee.Domain.Models.Direction, int> directionRepository;

<PageTitle>Applicants</PageTitle>

<h1>Applicants</h1>

<Button class="add-new-button" Clicked="@ShowAddModal">
    Добавить Абитуриента
</Button>

<div class="data-header">
    <div class="cell" style="max-width: 60px">Id</div>
    <div class="cell" style="max-width: 300px">Полное имя</div>
    <div class="cell">Дата рождения</div>
    <div class="cell">Родной город</div>
    <div class="cell">Родная страна</div>
    <div style="width: 100%; max-width: 50px"></div>
    <div style="width: 100%; max-width: 50px"></div>
</div>
<div class="data-container">
@foreach (var applicant in _applicants)
{
    <div class="data-row">
        <div class="cell" style="max-width: 60px">@(applicant.Id + 1)</div>
        <div class="cell" style="max-width: 300px">@applicant.FullName</div>
        <div class="cell">@applicant.BirthdayDate.Day / @applicant.BirthdayDate.Month / @applicant.BirthdayDate.Year</div>
        <div class="cell">@applicant.City</div>
        <div class="cell">@applicant.Country</div>
        <Button
            class="edit-item"
            @onclick="@(() => ShowUpdModal(applicant.Id))"
            Style="max-width: 50px"
        >
            UPD
        </Button>
        <Button
            class="delete-item"
            @onclick="@(() => DeleteApplicant(applicant.Id))"
            Style="max-width: 50px"
        >
            DEL
        </Button>
    </div>
}
</div>

<Modal @ref="modalRef" @bind-Visible="@modalVisible" style='@(modalVisible ? "display:block" : "display:none")'>
    <ModalContent Centered>
        <ModalHeader>
            <h5>Добавить абитуриента</h5>
        </ModalHeader>
        <ModalBody>
            <div class="mb-3">
                <label for="fullName">Полное имя:</label>
                <input type="text" id="fullName" @bind="newApplicant.FullName" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="birthdayDate">Дата рождения:</label>
                <input type="date" id="birthdayDate" @bind="newApplicant.BirthdayDate" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="city">Родной город:</label>
                <input type="text" id="city" @bind="newApplicant.City" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="country">Родная страна:</label>
                <input type="text" id="country" @bind="newApplicant.Country" class="form-control" />
            </div>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Primary" Clicked="@(forAdd ? AddNewApplicant : UpdateAppllicant)">
                @(forAdd ? "Добавить" : "Изменить")
            </Button>
            <Button Color="Color.Secondary" Clicked="@CancelHandler">
                Отмена
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>


@code {
    private List<Applicant> _applicants = new();
    private Modal? modalRef = null!;
    private Applicant newApplicant = new() { Id = 0, FullName = "", BirthdayDate = DateTime.ParseExact("01.01.1990", "dd.MM.yyyy", CultureInfo.InvariantCulture), City = "", Country = "" };
    private bool modalVisible;
    private bool forAdd = true;

    protected override async Task OnInitializedAsync()
    {
        _applicants = await applicantRepository.GetAll();
    }

    private async Task AddNewApplicant()
    {
        await applicantRepository.Add(newApplicant);
        _applicants = await applicantRepository.GetAll();
        await modalRef!.Hide();
    }

    private async Task DeleteApplicant(int applicantId)
    {
        await applicantRepository.Delete(applicantId);
        _applicants = await applicantRepository.GetAll();

        var directions = await directionRepository.GetAll();
        directions = directions.Select(d => d).Where(d => d.ApplicantId == applicantId).ToList();
        foreach (var d in directions)
        {
            await directionRepository.Delete(d.Id);
        }
    }

    private async Task UpdateAppllicant()
    {
        await applicantRepository.Update(newApplicant, newApplicant.Id);
        newApplicant = new() { Id = 0, FullName = "", BirthdayDate = DateTime.ParseExact("01.01.1990", "dd.MM.yyyy", CultureInfo.InvariantCulture), City = "", Country = "" };
        await applicantRepository.GetAll();
        await modalRef!.Hide();
    }

    private async Task ShowUpdModal(int applicantId)
    {
        forAdd = false;
        newApplicant = await applicantRepository.GetById(applicantId);
        await modalRef!.Show();
    }

    private async Task ShowAddModal() {
        forAdd = true;
        newApplicant = new() { Id = 0, FullName = "", BirthdayDate = DateTime.ParseExact("01.01.1990", "dd.MM.yyyy", CultureInfo.InvariantCulture), City = "", Country = "" };
        await modalRef!.Show();
    }

    private async Task CancelHandler()
    {
        await modalRef!.Hide();
    }

} 