@page "/examResults"
@inject HttpClient Http

<PageTitle>Exam Results</PageTitle>

<h1>Exam Results</h1>

<Button class="add-new-button" Clicked="@ShowAddModal" Color="Blazorise.Color.Primary">
    Добавить результат за экзамен
    <MudIcon Icon="@Icons.Material.Filled.Add" Color="MudBlazor.Color.Primary" />
</Button>

<div class="data-header">
    <div class="cell" style="max-width: 60px">Id</div>
    <div class="cell" style="max-width: 300px">Абитуриент</div>
    <div class="cell" style="max-width: 300px">Экзамен</div>
    <div class="cell" style="max-width: 300px">Результат</div>
    <div style="width: 100%; max-width: 89px"></div>
    <div style="width: 100%; max-width: 89px"></div>
</div>
<div class="data-container">
    @foreach (var examResult in _examResults)
    {
        <div class="data-row">
            <div class="cell" style="max-width: 60px">@(examResult.Id + 1)</div>
            <div class="cell" style="max-width: 300px">@(GetApplicantName(examResult.ApplicantId))</div>
            <div class="cell" style="max-width: 300px">@(examResult.ExamName)</div>
            <div class="cell" style="max-width: 300px">@examResult.Result</div>
            <Button Color="Blazorise.Color.Primary"
                class="edit-item"
                Style="max-width: 89px"
                TextAlignment="TextAlignment.Center"
                @onclick="@(() => ShowUpdModal(examResult.Id))">
                UPDATE
            </Button>
            <Button Color="Blazorise.Color.Danger"
                class="delete-item"
                @onclick="@(() => DeleteExamResult(examResult.Id))"
                Style="max-width: 89px"
                TextAlignment="TextAlignment.Center">
                DELETE
            </Button>
        </div>
    }
</div>

<Modal @ref="modalRef">
    <ModalContent Centered>
        <ModalHeader>
            <h5>Добавить результат</h5>
        </ModalHeader>
        <ModalBody>
            <div class="mb-3">
                <label for="applicantId">Абитуриент:</label>
                <select id="applicantId" @bind="newExamResult.ApplicantId">
                    @foreach (var applicant in _applicants)
                    {
                        <option>@applicant.Id</option>
                    }
                </select>
                <p class="form-control" style="border: none">@GetApplicantName(newExamResult.ApplicantId) | @(GetApplicantBirthDay(newExamResult.ApplicantId)) | @(GetApplicantCity(newExamResult.ApplicantId))</p>
            </div>

            <div class="mb-3">
                <label for="examName">Название экзамена:</label>
                <input type="text" id="examName" @bind="newExamResult.ExamName" class="form-control"/>
            </div>
            <div class="mb-3">
                <label for="result">Результат:</label>
                <div id="result" class="input-with-buttons">
                    <input type="number" @bind="newExamResult.Result" class="form-control" />
                </div>
            </div>
        </ModalBody>
        <ModalFooter>
            <Button Color="Blazorise.Color.Primary" Clicked="@(forAdd ? AddNewExamResult : UpdateExamResult)">
                @(forAdd ? "Добавить" : "Изменить")
            </Button>
            <Button Color="Blazorise.Color.Secondary" Clicked="@CancelHandler">
                Отмена
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    private List<Applicant> _applicants = new();
    private List<ExamResult> _examResults = new();
    private Modal? modalRef = null!;
    private ExamResult newExamResult = new() { Id = 0, ApplicantId = 0, ExamName = "", Result = 0 };
    private bool forAdd = true;
    private string examResultUrl = "api/ExamResult";

    private async Task UpdateMainList()
    {
        var response = await Http.GetFromJsonAsync<List<ExamResult>>(examResultUrl);
        if (response != null)
        {
            _examResults = response;
        }
    }

    private async Task LoadApplicants()
    {
        var applicantResponse = await Http.GetFromJsonAsync<List<Applicant>>("api/Applicant");
        if (applicantResponse != null)
        {
            _applicants = applicantResponse;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await UpdateMainList();
        await LoadApplicants();
    }

    private async Task AddNewExamResult()
    {
        await Http.PostAsJsonAsync<ExamResult>(examResultUrl, newExamResult);
        await UpdateMainList();
        await modalRef!.Hide();
    }

    private async Task DeleteExamResult(int examResultId)
    {
        await Http.DeleteAsync($"{examResultUrl}/{examResultId}");
        await UpdateMainList();
    }

    private async Task UpdateExamResult()
    {
        await Http.PutAsJsonAsync<ExamResult>($"{examResultUrl}/{newExamResult.Id}", newExamResult);
        await UpdateMainList();
        newExamResult = new() { Id = 0, ApplicantId = 0, ExamName = "", Result = 0 };
        await modalRef!.Hide();
    }

    private async Task ShowUpdModal(int examResultId)
    {
        forAdd = false;
        var response = await Http.GetFromJsonAsync<ExamResult>($"{examResultUrl}/{examResultId}");
        if (response != null)
        {
            newExamResult = response;
        }
        await modalRef!.Show();
    }

    private async Task ShowAddModal()
    {
        forAdd = true;
        newExamResult = new() { Id = 0, ApplicantId = 0, ExamName = "", Result = 0 };
        newExamResult.ApplicantId = _applicants.Select(a => a.Id).First();
        await modalRef!.Show();
    }

    private async Task CancelHandler()
    {
        await modalRef!.Hide();
    }

    private string GetApplicantName(int applicantId) => _applicants?.FirstOrDefault(a => a.Id == applicantId)?.FullName!;

    private string GetApplicantBirthDay(int applicantId) => _applicants?.FirstOrDefault(a => a.Id == applicantId)?.BirthdayDate.ToShortDateString()!;

    private string GetApplicantCity(int applicantId) => _applicants?.FirstOrDefault(a => a.Id == applicantId)?.City!;
}
