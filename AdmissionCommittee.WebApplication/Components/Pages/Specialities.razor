@page "/specialities"
@inject IRepository<Speciality, int> specialitiesRepository;

<PageTitle>Specialities</PageTitle>

<h1>Specialities</h1>

<Button class="add-new-button" Clicked="@ShowAddModal" Color="Blazorise.Color.Primary">
    Добавить специальность
    <MudIcon Icon="@Icons.Material.Filled.Add" Color="MudBlazor.Color.Primary" />
</Button>

<div class="data-header">
    <div class="cell" style="max-width: 60px">Id</div>
    <div class="cell" style="max-width: 300px">Номер специальности</div>
    <div class="cell" style="max-width: 300px">Название специальности</div>
    <div class="cell" style="max-width: 300px">Институт/факультет</div>
    <div style="width: 100%; max-width: 60px"></div>
    <div style="width: 100%; max-width: 60px"></div>
</div>
<div class="data-container">
    @foreach (var speciality in _specialities)
    {
        <div class="data-row">
            <div class="cell" style="max-width: 60px">@(speciality.Id + 1)</div>
            <div class="cell" style="max-width: 300px">@(speciality.Number)</div>
            <div class="cell" style="max-width: 300px">@(speciality.Name)</div>
            <div class="cell" style="max-width: 300px">@(speciality.Faculity)</div>
            <Button Color="Blazorise.Color.Primary"
                class="edit-item"
                Style="max-width: 60px"
                TextAlignment="TextAlignment.Center"
                @onclick="@(() => ShowUpdModal(speciality.Id))">
                UPD
            </Button>
            <Button Color="Blazorise.Color.Danger"
                class="delete-item"
                @onclick="@(() => DeleteSpeciality(speciality.Id))"
                Style="max-width: 60px"
                TextAlignment="TextAlignment.Center">
                DEL
            </Button>
        </div>
    }
</div>

<Modal @ref="modalRef">
    <ModalContent Centered>
        <ModalHeader>
            <h5>Добавить специальность</h5>
        </ModalHeader>
        <ModalBody>
            <div class="mb-3">
                <label for="number">Номер специальности:</label>
                <input type="text" id="number" @bind="newSpeciality.Number" />
            </div>
            <div class="mb-3">
                <label for="name">Название специальности:</label>
                <input type="text" id="name" @bind="newSpeciality.Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="faculty">Институт/факультет:</label>
                <input type="text" id="faculty" @bind="newSpeciality.Faculity" class="form-control" />
            </div>
        </ModalBody>
        <ModalFooter>
            <Button Color="Blazorise.Color.Primary" Clicked="@(forAdd ? AddNewSpeciality : UpdateSpeciality)">
                @(forAdd ? "Добавить" : "Изменить")
            </Button>
            <Button Color="Blazorise.Color.Secondary" Clicked="@CancelHandler">
                Отмена
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    private List<Speciality> _specialities = new();
    private Modal? modalRef = null!;
    private Speciality newSpeciality = new() { Id = 0, Name = "", Number = "", Faculity = "" };
    private bool forAdd = true;

    protected override async Task OnInitializedAsync()
    {
        _specialities = await specialitiesRepository.GetAll();
    }

    private async Task AddNewSpeciality()
    {
        await specialitiesRepository.Add(newSpeciality);
        _specialities = await specialitiesRepository.GetAll();
        await modalRef!.Hide();
    }

    private async Task DeleteSpeciality(int examResultId)
    {
        await specialitiesRepository.Delete(examResultId);
        _specialities = await specialitiesRepository.GetAll();
    }

    private async Task UpdateSpeciality()
    {
        await specialitiesRepository.Update(newSpeciality, newSpeciality.Id);
        newSpeciality = new() { Id = 0, Name = "", Number = "", Faculity = "" };
        _specialities = await specialitiesRepository.GetAll();
        await modalRef!.Hide();
    }

    private async Task ShowUpdModal(int examResultId)
    {
        forAdd = false;
        newSpeciality = await specialitiesRepository.GetById(examResultId);
        await modalRef!.Show();
    }

    private async Task ShowAddModal()
    {
        forAdd = true;
        newSpeciality = new() { Id = 0, Name = "", Number = "", Faculity = "" };
        await modalRef!.Show();
    }

    private async Task CancelHandler()
    {
        await modalRef!.Hide();
    }
}
